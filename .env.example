# PostgreSQL connection string, e.g. postgres://user:password@host:5432/reds.
# Required by the migration CLI (npm run db:migrate) and by the database tests,
# which skip themselves when it is unset so the default suite stays offline.
# The PostgreSQL repositories are not implemented yet; the application still
# runs on the in-memory ones without this variable.
DATABASE_URL=
# Per-process pool ceiling. Serverless runtimes open many short-lived pools, so
# keep this low and let an external pooler do the multiplexing.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
OPENAI_API_KEY=

# Canonical public origin, e.g. https://example.com (no trailing slash).
# Feeds sitemap.xml, the sitemap reference in robots.txt and metadataBase.
# Leave empty outside production: the sitemap is then served empty and no
# absolute URL is published, rather than pointing at a domain nobody owns.
# The robots disallow rules for internal screens apply either way.
NEXT_PUBLIC_SITE_URL=

# Centralized TASK-019 runtime mode. Risky integrations remain off by default.
REDS_APPLICATION_MODE=demo
REDS_PILOT_COHORT=internal_test
REDS_APP_VERSION=
REDS_FEATURE_USER_URL_INGESTION=true
REDS_FEATURE_LIVE_SOURCE_POC=false
REDS_FEATURE_REFRESH=false
REDS_FEATURE_EXPERT_REQUESTS=true
REDS_FEATURE_EXPERT_WORKBENCH=true
REDS_FEATURE_MANUAL_IMPORT=true
REDS_FEATURE_OPENCLAW_COLLECTION=false
REDS_KILL_LIVE_SOURCE_ADAPTER=true
REDS_KILL_OPENCLAW_EXECUTION=true
REDS_KILL_USER_URL_AUTOMATIC_INGESTION=true
REDS_KILL_REFRESH_EXECUTION=true

# Prerequisite configured by an operator outside this app (the app never edits it):
# gateway.http.endpoints.chatCompletions.enabled=true
# The Gateway token is a full operator credential. Keep it in secret storage.
# Endpoint must be a canonical loopback /v1/chat/completions URL.
REDS_OPENCLAW_GATEWAY_ENDPOINT=
REDS_OPENCLAW_AGENT_ID=
# Optional backend provider/model override, sent only as x-openclaw-model.
REDS_OPENCLAW_BACKEND_MODEL_OVERRIDE=
REDS_OPENCLAW_GATEWAY_TOKEN=
REDS_OPENCLAW_TIMEOUT_MS=
# Required bounded integer; no production default is applied.
REDS_OPENCLAW_MAX_COMPLETION_TOKENS=
