{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://real-estate-decision-service.local/schemas/1.0/property-financing-eligibility.schema.json",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "eligibility_id": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
    "property_id": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
    "offer_id": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
        { "type": "null" }
      ]
    },
    "program_id": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
        { "type": "null" }
      ]
    },
    "financing_offer_id": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
        { "type": "null" }
      ]
    },
    "eligibility_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "likely",
        "claimed",
        "not_eligible",
        "needs_confirmation",
        "unknown"
      ]
    },
    "initial_payment": {
      "type": "object",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                  "description": "A base-unit monetary amount encoded as a decimal string to avoid binary floating-point loss."
                },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
              },
              "required": ["amount", "currency"],
              "additionalProperties": false,
              "title": "Money"
            },
            { "type": "null" }
          ]
        },
        "percent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "A percentage encoded as a decimal string; business limits live outside schemas."
            },
            { "type": "null" }
          ]
        },
        "zero_payment_status": {
          "type": "string",
          "enum": ["available", "claimed", "not_available", "unknown"]
        }
      },
      "required": ["amount", "percent", "zero_payment_status"],
      "additionalProperties": false
    },
    "rate_structure": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "advertised_rate_percent": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                  "description": "A percentage encoded as a decimal string; business limits live outside schemas."
                },
                { "type": "null" }
              ]
            },
            "nominal_rate_percent": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                  "description": "A percentage encoded as a decimal string; business limits live outside schemas."
                },
                { "type": "null" }
              ]
            },
            "rate_from": {
              "anyOf": [{ "type": "boolean" }, { "type": "null" }]
            },
            "periods": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from_month": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "to_month": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      { "type": "null" }
                    ]
                  },
                  "rate_percent": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                    "description": "A percentage encoded as a decimal string; business limits live outside schemas."
                  },
                  "conditions": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                },
                "required": [
                  "from_month",
                  "to_month",
                  "rate_percent",
                  "conditions"
                ],
                "additionalProperties": false
              }
            },
            "after_introductory_period_rate_percent": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                  "description": "A percentage encoded as a decimal string; business limits live outside schemas."
                },
                { "type": "null" }
              ]
            },
            "conditions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": [
            "advertised_rate_percent",
            "nominal_rate_percent",
            "rate_from",
            "periods",
            "after_introductory_period_rate_percent",
            "conditions"
          ],
          "additionalProperties": false,
          "title": "RateStructure",
          "description": "Represents advertised, nominal and period-specific rates without collapsing staged rates into one number."
        },
        { "type": "null" }
      ]
    },
    "monthly_payment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "A base-unit monetary amount encoded as a decimal string to avoid binary floating-point loss."
            },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          },
          "required": ["amount", "currency"],
          "additionalProperties": false,
          "title": "Money"
        },
        { "type": "null" }
      ]
    },
    "applicability_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" }
    },
    "checked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        { "type": "null" }
      ]
    },
    "source_reference": {
      "type": "object",
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
        "snapshot_id": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
            { "type": "null" }
          ]
        },
        "source_url": {
          "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" }
        }
      },
      "required": ["source_id", "snapshot_id", "source_url", "evidence_ids"],
      "additionalProperties": false,
      "title": "SourceReference"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "claimed",
        "unconfirmed",
        "conflicting",
        "stale",
        "unknown"
      ]
    },
    "freshness_status": {
      "type": "string",
      "enum": ["fresh", "aging", "stale", "expired", "unknown"]
    }
  },
  "required": [
    "schema_version",
    "eligibility_id",
    "property_id",
    "offer_id",
    "program_id",
    "financing_offer_id",
    "eligibility_status",
    "initial_payment",
    "rate_structure",
    "monthly_payment",
    "applicability_evidence_refs",
    "checked_at",
    "source_reference",
    "verification_status",
    "freshness_status"
  ],
  "additionalProperties": false,
  "title": "PropertyFinancingEligibility"
}
