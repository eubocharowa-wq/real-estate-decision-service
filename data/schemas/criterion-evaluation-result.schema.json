{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://real-estate-decision-service.local/schemas/1.0/criterion-evaluation-result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "criterion_id": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
    "status": {
      "type": "string",
      "enum": [
        "matched",
        "partially_matched",
        "not_matched",
        "unknown",
        "conflicting",
        "not_applicable",
        "hard_failed"
      ]
    },
    "actual": { "$ref": "#/$defs/__schema0" },
    "target": { "$ref": "#/$defs/__schema1" },
    "fit": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "margin": { "$ref": "#/$defs/__schema2" },
    "verification_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "claimed",
        "unconfirmed",
        "conflicting",
        "stale",
        "unknown"
      ]
    },
    "freshness_status": {
      "type": "string",
      "enum": ["fresh", "aging", "stale", "expired", "unknown"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" }
    },
    "unknown_reason": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "explanation_data": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "$ref": "#/$defs/__schema3" }
    }
  },
  "required": [
    "schema_version",
    "criterion_id",
    "status",
    "actual",
    "target",
    "fit",
    "margin",
    "verification_status",
    "freshness_status",
    "evidence_refs",
    "unknown_reason",
    "explanation_data"
  ],
  "additionalProperties": false,
  "title": "CriterionEvaluationResult",
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema1" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema1" }
        }
      ]
    },
    "__schema2": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema2" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema2" }
        }
      ]
    },
    "__schema3": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema3" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema3" }
        }
      ]
    }
  }
}
