{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://real-estate-decision-service.local/schemas/1.0/source-snapshot.schema.json",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "snapshot_id": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
    "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
    "url": { "type": "string", "format": "uri" },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": {
      "type": "string",
      "enum": [
        "collected",
        "partial",
        "source_changed",
        "failed",
        "blocked",
        "unknown"
      ]
    },
    "structured_payload_reference": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "raw_reference": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "source_id",
    "url",
    "collected_at",
    "content_hash",
    "status",
    "structured_payload_reference",
    "raw_reference"
  ],
  "additionalProperties": false,
  "title": "SourceSnapshot"
}
