{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://real-estate-decision-service.local/schemas/1.0/financing-offer.schema.json",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "financing_offer_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9:_-]*$"
    },
    "program_id": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
    "provider": {
      "type": "object",
      "properties": {
        "provider_id": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
            { "type": "null" }
          ]
        },
        "provider_type": {
          "type": "string",
          "enum": ["bank", "developer", "government", "partner", "other"]
        },
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["provider_id", "provider_type", "name"],
      "additionalProperties": false
    },
    "rate_structure": {
      "type": "object",
      "properties": {
        "advertised_rate_percent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "A percentage encoded as a decimal string; business limits live outside schemas."
            },
            { "type": "null" }
          ]
        },
        "nominal_rate_percent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "A percentage encoded as a decimal string; business limits live outside schemas."
            },
            { "type": "null" }
          ]
        },
        "rate_from": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from_month": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "to_month": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  { "type": "null" }
                ]
              },
              "rate_percent": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                "description": "A percentage encoded as a decimal string; business limits live outside schemas."
              },
              "conditions": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "required": [
              "from_month",
              "to_month",
              "rate_percent",
              "conditions"
            ],
            "additionalProperties": false
          }
        },
        "after_introductory_period_rate_percent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "A percentage encoded as a decimal string; business limits live outside schemas."
            },
            { "type": "null" }
          ]
        },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "advertised_rate_percent",
        "nominal_rate_percent",
        "rate_from",
        "periods",
        "after_introductory_period_rate_percent",
        "conditions"
      ],
      "additionalProperties": false,
      "title": "RateStructure",
      "description": "Represents advertised, nominal and period-specific rates without collapsing staged rates into one number."
    },
    "initial_payment": {
      "type": "object",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                  "description": "A base-unit monetary amount encoded as a decimal string to avoid binary floating-point loss."
                },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
              },
              "required": ["amount", "currency"],
              "additionalProperties": false,
              "title": "Money"
            },
            { "type": "null" }
          ]
        },
        "percent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "A percentage encoded as a decimal string; business limits live outside schemas."
            },
            { "type": "null" }
          ]
        },
        "zero_payment_status": {
          "type": "string",
          "enum": ["available", "claimed", "not_available", "unknown"]
        }
      },
      "required": ["amount", "percent", "zero_payment_status"],
      "additionalProperties": false
    },
    "loan_amount": {
      "type": "object",
      "properties": {
        "minimum": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                  "description": "A base-unit monetary amount encoded as a decimal string to avoid binary floating-point loss."
                },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
              },
              "required": ["amount", "currency"],
              "additionalProperties": false,
              "title": "Money"
            },
            { "type": "null" }
          ]
        },
        "maximum": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                  "description": "A base-unit monetary amount encoded as a decimal string to avoid binary floating-point loss."
                },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
              },
              "required": ["amount", "currency"],
              "additionalProperties": false,
              "title": "Money"
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["minimum", "maximum"],
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "properties": {
        "minimum_months": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "maximum_months": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["minimum_months", "maximum_months"],
      "additionalProperties": false
    },
    "mandatory_services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "cost": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                    "description": "A base-unit monetary amount encoded as a decimal string to avoid binary floating-point loss."
                  },
                  "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
                },
                "required": ["amount", "currency"],
                "additionalProperties": false,
                "title": "Money"
              },
              { "type": "null" }
            ]
          },
          "required": { "type": "boolean" }
        },
        "required": ["name", "cost", "required"],
        "additionalProperties": false
      }
    },
    "price_impact": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["none", "increase", "decrease", "unknown"]
        },
        "amount": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
                  "description": "A base-unit monetary amount encoded as a decimal string to avoid binary floating-point loss."
                },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
              },
              "required": ["amount", "currency"],
              "additionalProperties": false,
              "title": "Money"
            },
            { "type": "null" }
          ]
        },
        "percent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "A percentage encoded as a decimal string; business limits live outside schemas."
            },
            { "type": "null" }
          ]
        },
        "description": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": ["kind", "amount", "percent", "description"],
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            { "type": "null" }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["from", "to"],
      "additionalProperties": false,
      "title": "DateRange"
    },
    "source_reference": {
      "type": "object",
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
        "snapshot_id": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" },
            { "type": "null" }
          ]
        },
        "source_url": {
          "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" }
        }
      },
      "required": ["source_id", "snapshot_id", "source_url", "evidence_ids"],
      "additionalProperties": false,
      "title": "SourceReference"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "claimed",
        "unconfirmed",
        "conflicting",
        "stale",
        "unknown"
      ]
    },
    "freshness_status": {
      "type": "string",
      "enum": ["fresh", "aging", "stale", "expired", "unknown"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9:_-]*$" }
    }
  },
  "required": [
    "schema_version",
    "financing_offer_id",
    "program_id",
    "provider",
    "rate_structure",
    "initial_payment",
    "loan_amount",
    "term",
    "mandatory_services",
    "price_impact",
    "validity",
    "source_reference",
    "verification_status",
    "freshness_status",
    "evidence_refs"
  ],
  "additionalProperties": false,
  "title": "FinancingOffer"
}
